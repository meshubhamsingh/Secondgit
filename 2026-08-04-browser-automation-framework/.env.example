# Copy this file to .env and fill in real values. Never commit the real .env.

# --- LLM provider (swappable without touching any code) ---
# Provider name understood by LiteLLM, e.g. "openai", "anthropic", "gemini"
LLM_PROVIDER=openai
# Model name as LiteLLM expects it, e.g. "gpt-4.1", "claude-sonnet-5", "gemini-1.5-pro"
LLM_MODEL=gpt-4.1
# API key for whichever provider is selected above
OPENAI_API_KEY=sk-replace-me
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Target application ---
BASE_URL=https://example.com
LOGIN_USERNAME=
LOGIN_PASSWORD=

# --- Run behavior ---
# stop | continue
ON_FAILURE=continue
MAX_RETRIES_PER_STEP=2
HEADLESS=false
# load | domcontentloaded | networkidle | commit
# "load" is the safe default. "networkidle" looks appealing but times out on
# sites with continuous background activity (analytics, personalization,
# long-polling) — Amazon is a textbook example of this. Only use networkidle
# if you've confirmed the target site actually goes idle.
NAV_WAIT_UNTIL=load

# Milliseconds to pause after navigation before the first candidate scan.
# Large sites often keep client-side hydrating/rendering well after the
# "load" event — without this, the walker can see a much sparser DOM than
# what's actually on screen a couple seconds later.
POST_NAV_SETTLE_MS=2000
# Milliseconds to pause between retry attempts on the same step, for the
# same reason — give a slow-rendering page a chance to catch up instead of
# retrying instantly against the same not-yet-ready DOM.
RETRY_DELAY_MS=1500
